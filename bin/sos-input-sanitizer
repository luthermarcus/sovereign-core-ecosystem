#!/usr/bin/env python3
import sys

def sanitize():
    raw = " ".join(sys.argv[1:]).strip()
    if not raw:
        print("[SOS CLI GUARD] Empty input stream.")
        return
    
    chat_triggers = ["hey", "claude", "here's", "this", "good", "step", "we ", "i ", "you "]
    lower_raw = raw.lower()
    
    is_chat = any(lower_raw.startswith(t) for t in chat_triggers) or len(raw.split()) > 4
    
    if is_chat:
        print("==============================================================================")
        print("  [SOS CLI GUARD WARNING] Natural language prose detected in terminal input.")
        print("  It appears you accidentally pasted chat text instead of a shell command.")
        print("  Input snippet: " + repr(raw[:60]) + "...")
        print("==============================================================================")
        sys.exit(0)
    else:
        print(f"[SOS CLI GUARD] '{raw}' is not a recognized microkernel applet. Run 'sos-skill-hub --list'.")
        sys.exit(1)

if __name__ == "__main__":
    sanitize()
