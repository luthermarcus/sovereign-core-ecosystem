#!/usr/bin/env python3
import sys, base64
full_key = 'ssh-ed25519 ' + ' '.join(sys.argv[1:])
b64 = base64.b64encode(full_key[:4096].encode('utf-8')).decode('ascii')
try:
    with open('/dev/tty', 'w') as tty:
        tty.write(f'\033]52;c;{b64}\a')
        tty.flush()
except Exception:
    pass
print('[!] SOS PASTE GUARD: Intercepted raw SSH public key pasted as a command.')
print('[+] Public key safely copied to clipboard via OSC 52.')
