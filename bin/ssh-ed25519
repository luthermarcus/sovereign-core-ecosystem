#!/data/data/com.termux/files/usr/bin/python3
import sys, base64
full_key = 'ssh-ed25519 ' + ' '.join(sys.argv[1:])
b64 = base64.b64encode(full_key.encode('utf-8')).decode('ascii')
try:
    with open('/dev/tty', 'w') as tty:
        tty.write(f'\033]52;c;{b64}\a')
        tty.flush()
except Exception:
    pass
print('[!] SOS PASTE GUARD: Detected raw SSH public key pasted as a command.')
print('[+] Copied your SSH public key to clipboard automatically via OSC 52.')
