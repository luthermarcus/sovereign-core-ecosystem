#!/usr/bin/env python3
import os, sys, math, sqlite3

repo = os.path.expanduser("~/sos-fox-beta")
db_path = os.path.join(repo, "sos_vault.db")

def get_routing_metrics():
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    cur.execute("SELECT gamma FROM sos_spacetime_anchors WHERE anchor_id='LORENTZ_HORIZON'")
    row = cur.fetchone()
    conn.close()
    return row[0] if row else 1.005

def softmax_bounded(logits, temperature=1.0):
    t = max(0.1, temperature)
    max_l = max(logits.values())
    exp_vals = {k: math.exp((v - max_l) / t) for k, v in logits.items()}
    total = sum(exp_vals.values())
    return {k: round(v / total, 4) for k, v in exp_vals.items()}

def compute_sparse_moe_routing(payload_type, byte_len):
    gamma = get_routing_metrics()
    
    # Base canonical logits
    if payload_type in ["CHUNK_MICRO_PAYOUT", "BITFIELD_STREAM"]:
        base_logits = {"L2_RELATIVISTIC_VM": 2.5, "L1_AUXPOW_BITCOIN": 0.5, "L3_SAVEPOINT_SANDBOX": -3.0}
    elif payload_type in ["AUXPOW_EPOCH", "HEADER_ATTESTATION"]:
        base_logits = {"L1_AUXPOW_BITCOIN": 3.0, "L2_RELATIVISTIC_VM": 0.2, "L3_SAVEPOINT_SANDBOX": -3.0}
    else:
        base_logits = {"L3_SAVEPOINT_SANDBOX": 3.0, "L2_RELATIVISTIC_VM": -2.0, "L1_AUXPOW_BITCOIN": -2.0}

    # Thermally scaled bounded softmax under Lorentz factor
    probs = softmax_bounded(base_logits, temperature=gamma)
    sorted_experts = sorted(probs.items(), key=lambda x: x[1], reverse=True)
    top1 = sorted_experts[0]
    top2 = sorted_experts[1]
    
    # Renormalize Top-2 pair
    pair_sum = top1[1] + top2[1]
    norm_w1 = round(top1[1] / pair_sum, 4)
    norm_w2 = round(top2[1] / pair_sum, 4)
    
    return {
        "payload": payload_type,
        "bytes": byte_len,
        "lorentz_gamma": gamma,
        "primary_expert": (top1[0], norm_w1),
        "secondary_expert": (top2[0], norm_w2)
    }

if len(sys.argv) > 2 and sys.argv[1] == "--gate":
    ptype = sys.argv[2]
    sz = int(sys.argv[3]) if len(sys.argv) > 3 else 32768
    decision = compute_sparse_moe_routing(ptype, sz)
    print("=== GROK-STYLE BOUNDED SOFTMAX MOE ROUTER ===")
    print(f"[*] Payload Target   : {decision['payload']} ({decision['bytes']}B)")
    print(f"[*] Relativistic Gas : Gamma = {decision['lorentz_gamma']}")
    print(f"[+] Primary Route    : {decision['primary_expert'][0]:<22} (Normalized: {decision['primary_expert'][1]*100:.1f}%)")
    print(f"[+] Secondary Route  : {decision['secondary_expert'][0]:<22} (Normalized: {decision['secondary_expert'][1]*100:.1f}%)")
else:
    print("=== SOVEREIGN GROK BOUNDED ROUTER ===")
    print("Usage:")
    print("  sos-grok-router --gate <type> [bytes]   Calculate bounded Top-2 MoE routing weights")
