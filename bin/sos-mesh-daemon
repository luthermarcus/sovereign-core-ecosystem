#!/usr/bin/env python3
import os, sys, time, json, hmac, socket, hashlib, sqlite3, threading

repo = os.path.expanduser("~/sos-fox-beta")
db_path = os.path.join(repo, "sos_vault.db")
dump_path = os.path.join(repo, "sos_vault_dump.sql")
pid_file = os.path.join(repo, "run", "sos_daemon.pid")
aux_root = "79569afdfbf56944ae735e2e27fd169e"

def get_enclave_key():
    ssh_priv = os.path.join(os.path.expanduser("~"), ".ssh", "id_ed25519")
    seed = open(ssh_priv, "rb").read() if os.path.exists(ssh_priv) else b"FALLBACK_NODE_SEED"
    return hashlib.sha256(seed + b":" + aux_root.encode()).digest()

def generate_auth_header(ch_id, sz, peer):
    now_t = int(time.time())
    ekey = get_enclave_key()
    tag = hmac.new(ekey, f"{ch_id}:{sz}:{peer}:{now_t}".encode(), hashlib.sha256).hexdigest()
    return json.dumps({
        "chunk_id": ch_id,
        "byte_len": sz,
        "peer_id": peer,
        "timestamp": now_t,
        "auth_tag": tag
    })

def handle_incoming_stream(conn, addr):
    conn.settimeout(5.0)
    try:
        raw_header = conn.recv(2048).decode('utf-8')
        if not raw_header:
            return
        meta = json.loads(raw_header)
        ch_id = meta.get("chunk_id", "")
        sz = meta.get("byte_len", 0)
        peer = meta.get("peer_id", addr[0])
        ts = meta.get("timestamp", 0)
        provided_tag = meta.get("auth_tag", "")
        
        now_t = int(time.time())
        # ENCLAVE GUARD 1: Replay protection (reject if timestamp delta > 30s)
        if abs(now_t - ts) > 30:
            conn.sendall(b'{"status": "ERR_TIMESTAMP_EXPIRED"}\n')
            return
            
        # ENCLAVE GUARD 2: Cryptographic signature verification
        ekey = get_enclave_key()
        expected_tag = hmac.new(ekey, f"{ch_id}:{sz}:{peer}:{ts}".encode(), hashlib.sha256).hexdigest()
        if not hmac.compare_digest(provided_tag, expected_tag):
            conn.sendall(b'{"status": "ERR_UNAUTHORIZED_SIGNATURE"}\n')
            return
            
        # Exact Satoshi conservation
        seeder_cut = int(sz * 0.15)
        creator_cut = sz - seeder_cut
        tx_id = hashlib.sha256(f"{ch_id}:{peer}:{now_t}".encode()).hexdigest()[:32]
        
        db = sqlite3.connect(db_path)
        cur = db.cursor()
        cur.execute(
            "INSERT OR REPLACE INTO sos_royalty_settlements VALUES (?, ?, ?, 'fox://l1/creator/vault', ?, ?, ?, 'SETTLED_TIMELIKE', ?)",
            (tx_id, ch_id, peer, creator_cut, peer, seeder_cut, now_t)
        )
        
        cur.execute("SELECT utxo_id FROM sos_utxo_logistics WHERE spent=0 ORDER BY recorded_at DESC LIMIT 1")
        prev = cur.fetchone()
        prev_id = prev[0] if prev else "GENESIS_COINBASE"
        new_utxo = hashlib.sha256(f"{prev_id}:{tx_id}:{now_t}".encode()).hexdigest()[:32]
        cur.execute("UPDATE sos_utxo_logistics SET spent=1 WHERE utxo_id=?", (prev_id,))
        cur.execute(
            "INSERT INTO sos_utxo_logistics VALUES (?, ?, 'P2P_DAEMON_INBOUND', ?, ?, ?, 0, ?)",
            (new_utxo, prev_id, peer, round(sz / 1024.0, 2), aux_root, now_t)
        )
        db.commit()
        db.close()
        conn.sendall(b'{"status": "ACK_AUTHENTICATED", "tx_id": "' + tx_id.encode() + b'"}\n')
    except Exception:
        pass
    finally:
        conn.close()

if len(sys.argv) > 1 and sys.argv[1] == "--listen":
    port = int(sys.argv[2]) if len(sys.argv) > 2 else 8088
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(('127.0.0.1', port))
    srv.listen(5)
    with open(pid_file, "w") as f:
        f.write(str(os.getpid()))
    print(f"[+] SOS Authenticated Daemon active on 127.0.0.1:{port} (PID: {os.getpid()})")
    try:
        while True:
            c, a = srv.accept()
            t = threading.Thread(target=handle_incoming_stream, args=(c, a), daemon=True)
            t.start()
    except KeyboardInterrupt:
        print("\n[*] Shutting down mesh daemon.")
    finally:
        if os.path.exists(pid_file):
            os.remove(pid_file)

elif len(sys.argv) > 2 and sys.argv[1] == "--send":
    target_addr = sys.argv[2]
    host, port = target_addr.split(":") if ":" in target_addr else (target_addr, 8088)
    port = int(port)
    
    # Grab latest local sealed chunk
    db = sqlite3.connect(db_path)
    cur = db.cursor()
    cur.execute("SELECT chunk_id, byte_len FROM sos_aead_chunks ORDER BY sealed_at DESC LIMIT 1")
    chunk = cur.fetchone()
    db.close()
    
    if not chunk:
        print("[!] No sealed chunks found to transmit.")
        sys.exit(1)
        
    ch_id, sz = chunk
    payload = generate_auth_header(ch_id, sz, "pixel-sovereign")
    
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(5.0)
    try:
        s.connect((host, port))
        s.sendall(payload.encode('utf-8'))
        resp = s.recv(1024).decode('utf-8')
        print(f"[+] Stream Handshake Success -> {host}:{port}")
        print(f"  * Response: {resp.strip()}")
    except Exception as e:
        print(f"[!] Stream Handshake Failed: {e}")
    finally:
        s.close()

elif len(sys.argv) > 1 and sys.argv[1] == "--rollup":
    db = sqlite3.connect(db_path)
    cur = db.cursor()
    cur.execute("SELECT settlement_id, creator_sats, seeder_sats FROM sos_royalty_settlements WHERE tx_status='SETTLED_TIMELIKE'")
    rows = cur.fetchall()
    if not rows:
        print("[i] No pending settlements to roll up.")
        db.close()
        sys.exit(0)
    total_vol = sum(r[1] + r[2] for r in rows)
    combined_hash = hashlib.sha256("".join(r[0] for r in rows).encode()).hexdigest()
    merkle_receipt = hashlib.sha256(f"{aux_root}:{combined_hash}".encode()).hexdigest()
    print("=== SOVEREIGN AUXPOW MERKLE ROLLUP RECEIPT ===")
    print(f"[*] Aggregated Records : {len(rows)} Settlement(s)")
    print(f"[*] Cumulative Volume  : {total_vol} sats")
    print(f"[*] AuxPoW Merkle Root : {aux_root}")
    print(f"[*] Rollup Proof Hash  : {merkle_receipt}")
    db.close()

else:
    print("=== SOVEREIGN ENCLAVE-AUTHENTICATED MESH DAEMON ===")
    print("Usage:")
    print("  sos-mesh-daemon --listen [port]         Start authenticated socket daemon (Default: 8088)")
    print("  sos-mesh-daemon --send <host:port>      Transmit authenticated chunk stream to peer")
    print("  sos-mesh-daemon --rollup                Generate AuxPoW Merkle rollup proof")
