#!/usr/bin/env python3
import os, sqlite3, subprocess

DB_PATH = os.path.expanduser("~/sos-fox-beta/sos_vault.db")

def audit_risks():
    print("=== SOS SECURITY RISK SENTINEL & DASHBOARD FLAGS ===")
    flags = []
    
    # 1. Enclave & Bitcoin Core Key Isolation Flag
    if os.path.exists(DB_PATH):
        mode = oct(os.stat(DB_PATH).st_mode)[-3:]
        if mode == "600":
            flags.append(("[VAULT_KEY_ISOLATION]", "LOCKED_0o600_AEAD", "PASS"))
        else:
            flags.append(("[VAULT_KEY_ISOLATION]", f"PERM_MISMATCH_{mode}", "WARN"))
            
    # 2. DEX FOX/BTC Swap & Mining Vault Airgap Flag
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    try:
        cur.execute("SELECT COUNT(*) FROM sos_aead_chunks;")
        chunks = cur.fetchone()[0]
        flags.append(("[DEX_FOX_BTC_VAULT]", f"ENCRYPTED_{chunks}_CHUNKS", "PASS"))
    except Exception:
        flags.append(("[DEX_FOX_BTC_VAULT]", "UNINITIALIZED", "WARN"))

    # 3. Bitcoin Sidechain Copyright Seal Flag
    try:
        cur.execute("SELECT COUNT(*) FROM sos_sidechain_copyright;")
        anchors = cur.fetchone()[0]
        flags.append(("[BTC_COPYRIGHT_SEAL]", f"L2_ANCHORS_{anchors}", "PASS"))
    except Exception:
        flags.append(("[BTC_COPYRIGHT_SEAL]", "PENDING_ANCHOR", "WARN"))

    # 4. Drainer & Permit2 Immunity Flag
    try:
        cur.execute("SELECT COUNT(*) FROM sos_threat_intel;")
        threats = cur.fetchone()[0]
        flags.append(("[FRAUD_DRAINER_SHIELD]", f"MITIGATED_{threats}_VECTORS", "PASS"))
    except Exception:
        flags.append(("[FRAUD_DRAINER_SHIELD]", "THREAT_DB_OFFLINE", "WARN"))
    conn.close()

    # 5. Native OS Metadata Airgap Flag
    hist = os.path.expanduser("~/.bash_history")
    if os.path.islink(hist) and os.readlink(hist) == "/dev/null":
        flags.append(("[OS_METADATA_AIRGAP]", "ROUTED_DEV_NULL", "PASS"))
    else:
        flags.append(("[OS_METADATA_AIRGAP]", "UNLINKED_HISTORY", "WARN"))

    # 6. Git Index Quarantine Flag
    res = subprocess.run(["git", "ls-files"], capture_output=True, text=True, cwd=os.path.expanduser("~/sos-fox-beta"))
    tracked = res.stdout.splitlines()
    has_db = any(f.endswith(".db") or f.endswith(".sql") or "vault_backups" in f for f in tracked)
    if not has_db:
        flags.append(("[GIT_INDEX_QUARANTINE]", "CLEAN_ZERO_LEAK", "PASS"))
    else:
        flags.append(("[GIT_INDEX_QUARANTINE]", "LEAK_EXPOSED", "FAIL"))

    for cat, status, verdict in flags:
        print(f"  {cat:<25} : {status:<24} [{verdict}]")
    print("====================================================")

if __name__ == "__main__":
    audit_risks()
