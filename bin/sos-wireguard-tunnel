#!/usr/bin/env python3
import os, sys, time, json, socket, hashlib, sqlite3, threading, subprocess

repo = os.path.expanduser("~/sos-fox-beta")
db_path = os.path.join(repo, "sos_vault.db")
dump_path = os.path.join(repo, "sos_vault_dump.sql")

def sync_dump(conn):
    conn.commit()
    with open(dump_path, "w") as f:
        for line in conn.iterdump():
            f.write(f"{line}\n")
    conn.execute("PRAGMA wal_checkpoint(TRUNCATE);")
    conn.close()

if len(sys.argv) > 1 and sys.argv[1] == "--test-loopback":
    test_port = 8089
    print(f"[*] Starting Automated P2P Loopback Test on 127.0.0.1:{test_port}...")
    
    # 1. Start daemon listener in background subprocess
    daemon_proc = subprocess.Popen(["sos-mesh-daemon", "--listen", str(test_port)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    time.sleep(0.4)
    
    # 2. Transmit authenticated chunk to loopback port
    try:
        res = subprocess.run(["sos-mesh-daemon", "--send", f"127.0.0.1:{test_port}"], capture_output=True, text=True)
        print(res.stdout.strip())
        success = "ACK_AUTHENTICATED" in res.stdout
    finally:
        daemon_proc.terminate()
        daemon_proc.wait()
        
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    if success:
        cur.execute(
            "UPDATE sos_wireguard_peers SET handshake_status='VERIFIED_TIMELIKE', last_handshake=? WHERE peer_name='peer-mint-bridge-01'",
            (int(time.time()),)
        )
        print("[+] Loopback Verification Succeeded: State logged to sos_wireguard_peers & UTXO chain.")
    else:
        print("[!] Loopback Verification Failed.")
    sync_dump(conn)

else:
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    print("=== SOVEREIGN WIREGUARD PEER MESH TOPOLOGY ===")
    for row in cur.execute("SELECT peer_name, endpoint, allowed_ips, handshake_status, last_handshake FROM sos_wireguard_peers"):
        print(f"  * Peer: {row[0]:<20} | Endpoint: {row[1]:<18} | Status: [{row[3]}]")
    conn.close()
