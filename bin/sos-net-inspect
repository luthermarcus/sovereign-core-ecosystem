#!/usr/bin/env python3
import socket, json

def check_port(host="127.0.0.1", port=8080):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(1.0)
    try:
        s.connect((host, port))
        active = True
    except (socket.timeout, ConnectionRefusedError):
        active = False
    finally:
        s.close()
    
    report = {
        "applet": "sos-net-inspect (Standard-Library Socket Health Inspector)",
        "binding_host": host,
        "port": port,
        "listener_active": active,
        "security_boundary": "STRICT_LOOPBACK_LOCAL_ONLY"
    }
    print(json.dumps(report, indent=2))

if __name__ == "__main__":
    check_port()
