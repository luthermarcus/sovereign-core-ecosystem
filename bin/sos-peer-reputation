#!/usr/bin/env python3
import os, sqlite3, time

BASE_DIR = os.path.expanduser("~/sos-fox-beta")
DB_PATH = os.path.join(BASE_DIR, "sos_vault.db")

def evaluate_reputation():
    if not os.path.exists(DB_PATH):
        print("[!] SOS Peer Reputation: Enclave DB not found.")
        return
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("SELECT peer_id, bandwidth_mbps, memory_score, priority_tier FROM sos_depin_peers;")
    rows = cur.fetchall()
    print(f"[*] SOS Peer Reputation Evaluation ({len(rows)} registered peers):")
    for peer_id, bw, mem, tier in rows:
        score = (bw * 0.6) + (mem * 40.0)
        print(f"    - Peer: {peer_id} | Tier: {tier} | Computed Trust Score: {score:.2f}")
    conn.close()

if __name__ == "__main__":
    evaluate_reputation()
