#!/usr/bin/env python3
import os, sqlite3

BASE_DIR = os.path.expanduser("~/sos-fox-beta")
DB_PATH = os.path.join(BASE_DIR, "sos_vault.db")

def check_epochs():
    if not os.path.exists(DB_PATH):
        print("[!] SOS Epoch Claims: Enclave DB not found.")
        return
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    try:
        cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='sos_epoch_claims';")
        if cur.fetchone():
            cur.execute("SELECT * FROM sos_epoch_claims;")
            rows = cur.fetchall()
            print(f"[*] SOS Epoch Claims Status ({len(rows)} records found):")
            for r in rows:
                print(f"    - Record: {r}")
        else:
            print("[*] SOS Epoch Claims: Table sos_epoch_claims pending initialization.")
    except Exception as e:
        print(f"[!] Epoch query error: {e}")
    conn.close()

if __name__ == "__main__":
    check_epochs()
