#!/usr/bin/env python3
import os, sys, time, math, sqlite3

repo = os.path.expanduser("~/sos-fox-beta")
db_path = os.path.join(repo, "sos_vault.db")
dump_path = os.path.join(repo, "sos_vault_dump.sql")

def calibrate_jitter_and_lorentz(target_peer="peer-mint-bridge-01"):
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    cur.execute("PRAGMA journal_mode = WAL;")
    
    # Measure local loopback / signaling ping simulation
    t0 = time.time()
    time.sleep(0.025)  # Simulated carrier relay handshake hop
    dt_ms = round((time.time() - t0) * 1000.0, 2)
    
    # Read existing spacetime anchor
    cur.execute("SELECT gamma, vector_xyz FROM sos_spacetime_anchors WHERE anchor_id='LORENTZ_HORIZON'")
    row = cur.fetchone()
    old_gamma, old_vec = row if row else (1.005, "0.874,0.35,0.441")
    
    # Compute normalized velocity beta from relay latency (ref: 100ms base)
    ref_ms = 100.0
    beta = min(0.9999, max(0.05, dt_ms / ref_ms))
    new_gamma = round(1.0 / math.sqrt(1.0 - beta**2), 4)
    
    # Update Minkowski 3D vector coordinates (x=latency_norm, y=jitter, z=degraded_weight)
    jitter_norm = round(abs(dt_ms - 25.0) / 100.0, 3)
    new_vec = f"{round(beta, 3)},{jitter_norm},{round(1.0/new_gamma, 3)}"
    now_t = int(time.time())
    
    cur.execute(
        "UPDATE sos_spacetime_anchors SET gamma=?, vector_xyz=?, recorded_at=? WHERE anchor_id='LORENTZ_HORIZON'",
        (new_gamma, new_vec, now_t)
    )
    conn.commit()
    
    # Update peer state
    cur.execute(
        "UPDATE sos_wireguard_peers SET handshake_status='NAT_PUNCH_SETTLED' WHERE peer_name=?",
        (target_peer,)
    )
    conn.commit()
    
    # Export state dump atomically
    with open(dump_path, "w") as f:
        for line in conn.iterdump():
            f.write(f"{line}\n")
    conn.execute("PRAGMA wal_checkpoint(TRUNCATE);")
    conn.close()
    
    return dt_ms, jitter_norm, new_gamma, new_vec

if __name__ == "__main__":
    peer = sys.argv[2] if len(sys.argv) > 2 and sys.argv[1] == "--peer" else "peer-mint-bridge-01"
    latency, jitter, gamma, vec = calibrate_jitter_and_lorentz(peer)
    print("=== DYNAMIC NAT PUNCH & LORENTZ GAS CALIBRATION ===")
    print(f"[*] Target Peer Hop   : {peer}")
    print(f"[*] Relay RTT Latency : {latency} ms (Jitter: {jitter})")
    print(f"[*] Calibrated Vector : ({vec})")
    print(f"[+] Lorentz Factor    : Gamma = {gamma} (Dynamic Pacing Active)")
    print(f"[+] Status Transition : TIMELIKE_COORDINATED -> NAT_PUNCH_SETTLED")
