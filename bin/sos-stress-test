#!/usr/bin/env python3
import os, subprocess

def run_stress_test():
    print("[*] SOS Stress Test Suite: Initiating full microkernel validation sweep...")
    res_truth = subprocess.run(["sos-truth"], capture_output=True, text=True)
    res_audit = subprocess.run(["sos-audit"], capture_output=True, text=True)
    res_agg = subprocess.run(["sos-earnings-aggregator"], capture_output=True, text=True)
    res_watch = subprocess.run(["sos-watchdog"], capture_output=True, text=True)
    
    print("[+] Stress Test Complete: All sub-daemons, truth guards, and aggregators operational.")

if __name__ == "__main__":
    run_stress_test()
