#!/usr/bin/env python3
import os, sqlite3, sys

DB_PATH = os.path.expanduser("~/sos-fox-beta/sos_vault.db")

def verify_wallet_isolation():
    print("[*] SOS Wallet Guard: Auditing DEX FOX/BTC Enclave & Key Isolation...")
    if not os.path.exists(DB_PATH):
        print("[!] Enclave DB not found.")
        return 1
    mode = oct(os.stat(DB_PATH).st_mode)[-3:]
    if mode != "600":
        print(f"[!] PRIVACY VIOLATION: Vault permissions {mode} != 600.")
        return 1
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("SELECT COUNT(*) FROM sos_aead_chunks;")
    chunks = cur.fetchone()[0]
    cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';")
    tables = [r[0] for r in cur.fetchall()]
    for tbl in tables:
        cur.execute(f"PRAGMA table_info({tbl});")
        cols = [c[1] for c in cur.fetchall()]
        for c in cols:
            cur.execute(f"SELECT COUNT(*) FROM {tbl} WHERE {c} LIKE '%xprv%' OR {c} LIKE '%nsec%' OR {c} LIKE '%mnemonic%';")
            raw_leaks = cur.fetchone()[0]
            if raw_leaks > 0:
                print(f"[!] CRITICAL LEAK: Unencrypted key material found in table {tbl}:{c}")
                conn.close()
                return 1
    conn.close()
    print(f"[+] SOS Wallet Guard PASS: Master keys airgapped in {chunks} AEAD chunk(s). Zero cleartext keys exposed.")
    return 0

if __name__ == "__main__":
    sys.exit(verify_wallet_isolation())
