#!/usr/bin/env python3
import os, sys, subprocess

repo = os.path.expanduser('~/sos-fox-beta')
os.chdir(repo)

subprocess.run(['sos-vault', '--pulse'], check=False)

status = subprocess.run(['git', 'status', '--porcelain'], capture_output=True, text=True).stdout.strip()
if not status:
    print('[=] Invariant Git Gate: Working tree is 100% clean. Zero redundant commits or network pushes.')
else:
    msg = sys.argv[1] if len(sys.argv) > 1 else 'Autonomous Invariant Sync'
    subprocess.run(['git', 'add', '-A'], check=False)
    subprocess.run(['git', 'commit', '-m', f'SOS Pulse: {msg}'], check=False)
    subprocess.run(['sos', '--git-push', 'https://github.com/luthermarcus/sovereign-core-ecosystem.git'], check=False)
