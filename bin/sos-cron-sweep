#!/usr/bin/env python3
import os, time, sqlite3

BASE_DIR = os.path.expanduser("~/sos-fox-beta")
DB_PATH = os.path.join(BASE_DIR, "sos_vault.db")

def run_sweep():
    if os.path.exists(DB_PATH):
        conn = sqlite3.connect(DB_PATH)
        conn.execute("PRAGMA wal_checkpoint(PASSIVE);")
        conn.close()
        print(f"[*] SOS Cron Sweep: Enclave WAL passive checkpoint synchronized at {time.strftime('%Y-%m-%d %H:%M:%S')}")

if __name__ == "__main__":
    run_sweep()
