#!/usr/bin/env python3
import http.server, sqlite3, json, os, time, math, hashlib, urllib.parse

PORT = 8080
BASE_DIR = os.path.expanduser("~/sos-fox-beta")
VAULT_DB_PATH = os.path.join(BASE_DIR, "sos_vault.db")
BACKUP_DIR = os.path.join(BASE_DIR, "vault_backups")
FRONTEND_DIR = os.path.join(BASE_DIR, "web_frontend")
BOOT_MONO = time.monotonic()
BASE_TAU = 955.22
RELEASE_TAG = "v7.71.91-beta"
LEDGER_TABLES = ["sos_utxo_logistics", "sos_royalty_settlements", "sos_knowledge_fts"]

def compute_workspace_merkle():
    merkle = hashlib.sha256()
    files_hashed = 0
    scan_dirs = [BASE_DIR, os.path.join(BASE_DIR, "bin"), os.path.join(BASE_DIR, "web_frontend")]
    for d in scan_dirs:
        if not os.path.isdir(d):
            continue
        for fname in sorted(os.listdir(d)):
            fpath = os.path.join(d, fname)
            if os.path.isfile(fpath) and not os.path.islink(fpath):
                try:
                    raw = open(fpath, "rb").read()
                    rel = os.path.relpath(fpath, BASE_DIR)
                    merkle.update(rel.encode("utf-8") + b"\0" + hashlib.sha256(raw).digest())
                    files_hashed += 1
                except OSError:
                    pass
    return merkle.hexdigest(), files_hashed

def compute_relativistic_state():
    try:
        load1 = os.getloadavg()[0]
    except (AttributeError, OSError):
        load1 = 0.10
    cpu_count = os.cpu_count() or 8
    beta = min(max(load1 / float(cpu_count), 0.0995), 0.99)
    gamma = round(1.0 / math.sqrt(1.0 - (beta * beta)), 6)
    dt = time.monotonic() - BOOT_MONO
    proper_time = round(BASE_TAU + (dt / gamma), 2)
    return gamma, proper_time

def fetch_table(conn, table_name, limit=100):
    cur = conn.cursor()
    cur.execute(f"PRAGMA table_info({table_name})")
    columns = [row[1] for row in cur.fetchall()]
    if not columns:
        return {"error": f"table '{table_name}' not found"}
    cur.execute(f"SELECT * FROM {table_name} LIMIT ?", (limit,))
    rows = [dict(zip(columns, row)) for row in cur.fetchall()]
    return {"columns": columns, "rows": rows, "row_count": len(rows)}

def fetch_joined_provenance(conn):
    cur = conn.cursor()
    sql = """
        SELECT
            u.utxo_id,
            u.parcel_type,
            u.custody_node,
            u.depin_kb,
            u.spent,
            COALESCE(r.settlement_id, 'GENESIS_ANCHOR') AS settlement_id,
            COALESCE(r.creator_sats, 0) AS creator_sats,
            COALESCE(r.seeder_sats, 0) AS seeder_sats,
            COALESCE(r.tx_status, 'ANCHORED') AS tx_status,
            COALESCE(k.category, 'UNINDEXED') AS fts_category,
            u.recorded_at
        FROM sos_utxo_logistics u
        LEFT JOIN sos_royalty_settlements r
            ON u.recorded_at = r.recorded_at AND u.custody_node = r.payer_node
        LEFT JOIN sos_knowledge_fts k
            ON u.auxpow_root = k.sha256_digest
        ORDER BY u.recorded_at ASC
    """
    cur.execute(sql)
    cols = [d[0] for d in cur.description]
    rows = [dict(zip(cols, r)) for r in cur.fetchall()]
    return {"columns": cols, "rows": rows, "row_count": len(rows)}

def build_ledger_payload():
    conn = sqlite3.connect(VAULT_DB_PATH)
    try:
        payload = {t: fetch_table(conn, t) for t in LEDGER_TABLES}
        payload["joined_provenance"] = fetch_joined_provenance(conn)
        return payload
    finally:
        conn.close()

def search_knowledge_fts(query_str):
    conn = sqlite3.connect(VAULT_DB_PATH)
    try:
        cur = conn.cursor()
        cols = ["source_uri", "capture_ts", "sha256_digest", "category", "payload"]
        q = (query_str or "").strip()
        if not q:
            cur.execute("SELECT source_uri, capture_ts, sha256_digest, category, payload FROM sos_knowledge_fts LIMIT 50")
        else:
            safe_q = '"' + q.replace('"', '""') + '"'
            cur.execute(
                "SELECT source_uri, capture_ts, sha256_digest, category, payload FROM sos_knowledge_fts WHERE sos_knowledge_fts MATCH ? LIMIT 50",
                (safe_q,)
            )
        rows = [dict(zip(cols, r)) for r in cur.fetchall()]
        return {"query": q, "columns": cols, "rows": rows, "row_count": len(rows)}
    finally:
        conn.close()

def query_enclave_audit():
    tables = {}
    journal_mode = "unknown"
    integrity = "unverified"
    if os.path.exists(VAULT_DB_PATH):
        try:
            conn = sqlite3.connect(VAULT_DB_PATH)
            cur = conn.cursor()
            journal_mode = cur.execute("PRAGMA journal_mode").fetchone()[0]
            integrity = cur.execute("PRAGMA quick_check").fetchone()[0]
            names = [r[0] for r in cur.execute("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name").fetchall()]
            for tname in names:
                if tname.replace("_", "").isalnum():
                    tables[tname] = cur.execute(f"SELECT COUNT(*) FROM {tname}").fetchone()[0]
            conn.close()
        except sqlite3.Error as e:
            integrity = f"error: {e}"
    snapshots = []
    if os.path.isdir(BACKUP_DIR):
        for fname in sorted(os.listdir(BACKUP_DIR)):
            fpath = os.path.join(BACKUP_DIR, fname)
            if os.path.isfile(fpath):
                snapshots.append({"file": fname, "bytes": os.path.getsize(fpath)})
    return {
        "db_bytes": os.path.getsize(VAULT_DB_PATH) if os.path.exists(VAULT_DB_PATH) else 0,
        "journal_mode": journal_mode,
        "integrity": integrity,
        "tables": tables,
        "wal_snapshots": snapshots
    }

class ThreadedSovereignServer(http.server.ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True

class SovereignBridgeHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=FRONTEND_DIR, **kwargs)

    def log_message(self, fmt, *args):
        pass

    def _send_json(self, data, status=200):
        payload = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/api/telemetry":
            gateways = []
            if os.path.exists(VAULT_DB_PATH):
                try:
                    conn = sqlite3.connect(VAULT_DB_PATH)
                    cur = conn.cursor()
                    gateways = cur.execute("SELECT * FROM sos_mesh_gateways").fetchall()
                    conn.close()
                except sqlite3.Error:
                    gateways = []
            gamma, proper_time = compute_relativistic_state()
            merkle_root, files_hashed = compute_workspace_merkle()
            self._send_json({
                "node": "pixel-sovereign",
                "release": RELEASE_TAG,
                "gamma": gamma,
                "proper_time": proper_time,
                "ground_truth_hash": merkle_root,
                "workspace_merkle_root": merkle_root,
                "hash_len": len(merkle_root),
                "files_hashed": files_hashed,
                "gateways": gateways,
                "status": "INVARIANT_ACTIVE"
            })
        elif parsed.path == "/api/audit":
            self._send_json(query_enclave_audit())
        elif parsed.path == "/api/ledger":
            try:
                self._send_json(build_ledger_payload())
            except Exception as e:
                self._send_json({"error": str(e)}, status=500)
        elif parsed.path == "/api/search":
            try:
                qs = urllib.parse.parse_qs(parsed.query)
                q = qs.get("q", [""])[0]
                self._send_json(search_knowledge_fts(q))
            except Exception as e:
                self._send_json({"error": str(e)}, status=500)
        else:
            super().do_GET()

if __name__ == "__main__":
    os.makedirs(FRONTEND_DIR, exist_ok=True)
    server = ThreadedSovereignServer(("127.0.0.1", PORT), SovereignBridgeHandler)
    print(f"[*] Sovereign Web Bridge active on http://127.0.0.1:{PORT}")
    server.serve_forever()
