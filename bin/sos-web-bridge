#!/data/data/com.termux/files/usr/bin/python3
import sys
import os

script_path = "/data/data/com.termux/files/home/sos-fox-beta/bin/sos-web-bridge"
with open(script_path, "rb") as sf:
    code_bytes = sf.read()

# Execute script code within the current global namespace
global_ns = {"__name__": "__main__", "__file__": script_path}
exec(compile(code_bytes, script_path, 'exec'), global_ns)
