    subprocess.run(["sos-legal-sentinel"])
    subprocess.run(["sos-ratchet-enclave"])
    subprocess.run(["sos-sidechain-anchor"])
    subprocess.run(["sos-canary-wall"])
    subprocess.run(["sos-earnings-aggregator"])
    subprocess.run(["sos-peer-reputation"])
    subprocess.run(["sos-epoch-claims"])
