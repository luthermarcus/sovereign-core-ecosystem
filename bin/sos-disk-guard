#!/usr/bin/env python3
import os

def check_disk():
    base_dir = os.path.expanduser("~/sos-fox-beta")
    st = os.statvfs(base_dir)
    free_mb = (st.f_bavail * st.f_frsize) / (1024 * 1024)
    print(f"[*] SOS Disk Guard: Available storage in workspace = {free_mb:.2f} MB")
    if free_mb < 100:
        print("[!] SOS Disk Guard Warning: Low disk space detected.")
    else:
        print("[+] SOS Disk Guard: Storage quota nominal.")

if __name__ == "__main__":
    check_disk()
