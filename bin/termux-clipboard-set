#!/usr/bin/env python3
import sys, base64
MAX_BYTES = 65536
data = sys.stdin.buffer.read(MAX_BYTES + 1)
if len(data) > MAX_BYTES:
    print('[!] SOS SECURITY SHIELD: Clipboard input exceeds 64KB OSC 52 DoS limit. Truncating safely.')
    data = data[:MAX_BYTES]
b64 = base64.b64encode(data).decode('ascii')
try:
    with open('/dev/tty', 'w') as tty:
        tty.write(f'\033]52;c;{b64}\a')
        tty.flush()
    print(f'[+] Copied {len(data)} bytes to clipboard via zero-hang ANSI OSC 52 (64KB DoS Shield Active).')
except Exception as e:
    print(f'[!] Terminal TTY unavailable for OSC 52: {e}')
