#!/usr/bin/env python3
import json, os, sqlite3, subprocess, sys

WORKSPACE = os.path.expanduser("~/sos-fox-beta")
DB_PATH = os.path.join(WORKSPACE, "sos_vault.db")

def query_threats():
    if not os.path.exists(DB_PATH):
        return []
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    try:
        cur.execute("SELECT threat_id, vector, mitigation FROM sos_threat_intel;")
        rows = cur.fetchall()
    except Exception:
        rows = []
    conn.close()
    return rows

def render_dash():
    print("""
==============================================================================
  SOVEREIGN CORE OS (SOS v7.71.135-beta) - MASTER RESILIENCE CONSOLE         
  Mode: DEVELOPMENTAL / PRE-RELEASE | Host Identity: AIRGAPPED_ANONYMOUS     
==============================================================================
""")
    # 1. Master Layer Status & Vulnerability Flags
    print("--- [1] ACTIVE INVARIANT MATRIX & SECURITY FLAGS ---")
    subprocess.run(["sos-risk-sentinel"])
    
    # 2. Military Enclave & Key Isolation
    print("\n--- [2] MULTI-LEVEL SECURITY & ENCLAVE INTEGRITY ---")
    subprocess.run(["sos-military-enclave"])
    subprocess.run(["sos-wallet-guard"])
    
    # 3. Swaps, Boomerang Queue & Regulatory Status
    print("\n--- [3] ATOMIC SWAPS, BOOMERANG QUEUE & ALLOCATIONS ---")
    subprocess.run(["sos-boomerang-engine"])
    subprocess.run(["sos-ptlc-verifier"])
    subprocess.run(["sos-allocation-guard"])
    
    # 4. Known Threat Knowledge Base Flags
    print("\n--- [4] THREAT INTEL KNOWLEDGE BASE (COMMUNITY AUDITED) ---")
    threats = query_threats()
    if threats:
        for tid, vec, mit in threats:
            print(f"  [{tid:<17}] {vec:<26} -> {mit}")
    else:
        print("  [*] Enclave threat database operational (0 unhandled vectors).")

    # 5. Interactive Help & Fallback Commands
    print("""
==============================================================================
  OPERATIONAL PALETTE & RECOVERY HELP MENU:
    sos-dash        - Render this complete master resilience console
    sos-status      - Execute quick diagnostic health sweep
    sos-fallback    - Initiate automated rollback to verified stable release
    sos-ptlc-engine - Execute discrete Schnorr adaptor atomic swap simulator
    sos-truth       - Run 8-point deterministic zero-drift assertion audit
    sos-audit-health- Execute complete master ledger & UTXO logistics audit
==============================================================================
""")

if __name__ == "__main__":
    render_dash()
