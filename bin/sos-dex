#!/usr/bin/env python3
import os, sys, time, hashlib, sqlite3

repo = os.path.expanduser("~/sos-fox-beta")
db_path = os.path.join(repo, "sos_vault.db")
dump_path = os.path.join(repo, "sos_vault_dump.sql")

def sync_dump(conn):
    conn.commit()
    with open(dump_path, "w") as f:
        for line in conn.iterdump():
            f.write(f"{line}\n")
    conn.execute("PRAGMA wal_checkpoint(TRUNCATE);")
    conn.close()

def init_dex_table(cur):
    cur.execute("CREATE TABLE IF NOT EXISTS sos_atomic_swaps (swap_id TEXT PRIMARY KEY, maker_node TEXT, taker_node TEXT, amount_offered INTEGER, amount_requested INTEGER, swap_status TEXT, created_at INTEGER)")

def create_atomic_swap(maker, offered_sats, requested_sats):
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    cur.execute("PRAGMA journal_mode = WAL;")
    init_dex_table(cur)
    
    now_t = int(time.time())
    swap_id = hashlib.sha256(f"{maker}:{offered_sats}:{requested_sats}:{now_t}".encode()).hexdigest()[:32]
    
    cur.execute(
        "INSERT INTO sos_atomic_swaps VALUES (?, ?, 'PENDING_TAKER', ?, ?, 'OPEN', ?)",
        (swap_id, maker, offered_sats, requested_sats, now_t)
    )
    
    sync_dump(conn)
    conn.close()
    return swap_id

if len(sys.argv) > 3 and sys.argv[1] == "--create":
    maker = sys.argv[2]
    offered = int(sys.argv[3])
    requested = int(sys.argv[4]) if len(sys.argv) > 4 else int(offered * 1.05)
    sid = create_atomic_swap(maker, offered, requested)
    print("=== SOVEREIGN P2P ATOMIC SWAP (DEX) ===")
    print(f"[+] Swap Order Created : {sid}")
    print(f"[+] Maker Node         : {maker}")
    print(f"[+] Offered / Requested: {offered} sats / {requested} sats")
    print(f"[+] Custody Status     : TRUSTLESS_HTLC (Zero central exchange risk)")
else:
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    init_dex_table(cur)
    print("=== SOVEREIGN P2P DEX ORDERBOOK ===")
    for r in cur.execute("SELECT swap_id, maker_node, amount_offered, amount_requested, swap_status FROM sos_atomic_swaps"):
        print(f"  * ID: {r[0][:8]}... | Maker: {r[1]} | Offer: {r[2]} sats -> Ask: {r[3]} sats | [{r[4]}]")
    conn.close()
    print("Usage: sos-dex --create <maker> <offered_sats> <requested_sats>")
