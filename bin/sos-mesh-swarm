#!/usr/bin/env python3
import os, sys, time, json, socket, hashlib, sqlite3

repo = os.path.expanduser("~/sos-fox-beta")
db_path = os.path.join(repo, "sos_vault.db")

def check_peer_status(endpoint_str):
    host, port = endpoint_str.split(":") if ":" in endpoint_str else (endpoint_str, 8088)
    port = int(port)
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.5)
    try:
        s.connect((host, port))
        s.close()
        return "ONLINE_REACHABLE"
    except Exception:
        return "STANDBY_OFFLINE"

if len(sys.argv) > 1 and sys.argv[1] == "--ping":
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    cur.execute("SELECT peer_name, endpoint, handshake_status FROM sos_wireguard_peers")
    rows = cur.fetchall()
    print("=== SOVEREIGN P2P MESH SWARM DISCOVERY ===")
    for name, ep, status in rows:
        probe = check_peer_status(ep)
        cur.execute("UPDATE sos_wireguard_peers SET handshake_status=? WHERE peer_name=?", (probe, name))
        print(f"  * [{probe}] {name:<20} @ {ep:<18} (Prev: {status})")
    conn.commit()
    conn.close()

else:
    print("=== SOVEREIGN SWARM CONTROLLER ===")
    print("Usage:")
    print("  sos-mesh-swarm --ping          Ping all configured mesh peers and update connection status")
