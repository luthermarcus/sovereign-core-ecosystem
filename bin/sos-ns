#!/usr/bin/env python3
import os, sys, sqlite3, hashlib, time

repo = os.path.expanduser("~/sos-fox-beta")
db_path = os.path.join(repo, "sos_vault.db")
dump_path = os.path.join(repo, "sos_vault_dump.sql")

def sync_dump(conn):
    conn.commit()
    with open(dump_path, "w") as f:
        for line in conn.iterdump():
            f.write(f"{line}\n")
    conn.execute("PRAGMA wal_checkpoint(TRUNCATE);")
    conn.close()

def init_ns_table(cur):
    cur.execute("CREATE TABLE IF NOT EXISTS sos_name_registry (name TEXT PRIMARY KEY, target_id TEXT, record_type TEXT, updated_at INTEGER)")

def register_name(name, target_id, record_type="PEER_ENDPOINT"):
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    cur.execute("PRAGMA journal_mode = WAL;")
    init_ns_table(cur)
    
    now_t = int(time.time())
    cur.execute("INSERT OR REPLACE INTO sos_name_registry VALUES (?, ?, ?, ?)", (name, target_id, record_type, now_t))
    sync_dump(conn)
    conn.close()
    return True

def resolve_name(name):
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    init_ns_table(cur)
    cur.execute("SELECT target_id, record_type, updated_at FROM sos_name_registry WHERE name=?", (name,))
    row = cur.fetchone()
    conn.close()
    return row

if len(sys.argv) > 2 and sys.argv[1] == "--register":
    name = sys.argv[2]
    target = sys.argv[3] if len(sys.argv) > 3 else "pixel-sovereign"
    rtype = sys.argv[4] if len(sys.argv) > 4 else "PEER_ENDPOINT"
    register_name(name, target, rtype)
    print("=== SOVEREIGN NAME REGISTRY ===")
    print(f"[+] Record Registered : '{name}' -> {target} [{rtype}]")
elif len(sys.argv) > 2 and sys.argv[1] == "--resolve":
    name = sys.argv[2]
    res = resolve_name(name)
    print("=== SOVEREIGN NAME RESOLUTION ===")
    if res:
        print(f"[+] Resolved Name   : '{name}'")
        print(f"[*] Target ID       : {res[0]}")
        print(f"[*] Record Type     : {res[1]}")
        print(f"[*] Updated At      : {res[2]}")
    else:
        print(f"[!] Resolution Error: Name '{name}' not found in local decentralized registry.")
else:
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    init_ns_table(cur)
    print("=== SOVEREIGN DECENTRALIZED NAME SERVICE (SOS-NS) ===")
    records = cur.execute("SELECT name, target_id, record_type FROM sos_name_registry").fetchall()
    if not records:
        print("[*] Registry empty. Register via 'sos-ns --register <name> <target>'")
    for r in records:
        print(f"  * {r[0]} -> {r[1]} [{r[2]}]")
    conn.close()
    print("Usage:")
    print("  sos-ns --register <name> <target> [type]")
    print("  sos-ns --resolve <name>")
