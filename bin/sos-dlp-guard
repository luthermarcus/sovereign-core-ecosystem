#!/usr/bin/env python3
import fnmatch, os, re, subprocess, sys

FORBIDDEN = {"sos_vault.db", "sos_vault_dump.sql", "fox_wallet_meta.json", "session_transcript.log", "bips_private", "vault_backups"}
PEM = re.compile(r"-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----")
XPRV = re.compile(r"\b[xyztuv]prv[1-9A-HJ-NP-Za-km-z]{100,112}\b")
HEXKEY = re.compile(r"(?i)(?:priv(?:ate)?[_ -]?key|secret|seed)[\"'\s:=]{1,6}(?:0x)?[0-9a-f]{64}\b")
RUN = re.compile(r"(?:\b[a-z]{3,8}\b[ \t,]+){11,}\b[a-z]{3,8}\b")
HINT = re.compile(r"(?i)mnemonic|seed|recovery|bip-?39|passphrase|wallet")

def mnemonic_hit(line):
    low = line.lower()
    m = RUN.search(low)
    if not m:
        return False
    if HINT.search(line):
        return True
    core = " ".join(re.sub(r"[\"'`\[\](){},;:]+", " ", low).split())
    return core == " ".join(m.group(0).replace(",", " ").split()) and len(core.split()) in (12, 15, 18, 21, 24)

def git(*args):
    return subprocess.run(("git",) + args, capture_output=True).stdout

def main():
    names = git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z").decode("utf-8", "replace").split("\0")
    for path in [p for p in names if p]:
        parts = path.split("/")
        if any(f in parts for f in FORBIDDEN):
            sys.stderr.write(f"[sos-dlp-guard] BLOCKED: Purged artifact in path {path}\n")
            return 1
        blob = git("show", ":" + path)
        if len(blob) > 2000000 or b"\0" in blob[:8192]:
            continue
        for n, line in enumerate(blob.decode("utf-8", "replace").splitlines(), 1):
            if PEM.search(line) or XPRV.search(line) or HEXKEY.search(line) or mnemonic_hit(line):
                sys.stderr.write(f"[sos-dlp-guard] BLOCKED: Key/mnemonic pattern in {path}:{n}\n")
                return 1
    return 0

if __name__ == "__main__":
    sys.exit(main())
