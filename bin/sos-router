#!/usr/bin/env python3
import os, sys, time, json, sqlite3

repo = os.path.expanduser("~/sos-fox-beta")
db_path = os.path.join(repo, "sos_vault.db")

def route_payload(payload_type, size_bytes):
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    
    # Deterministic Layer Routing Policy
    if payload_type in ["CHUNK_MICRO_PAYOUT", "BITFIELD_STREAM", "P2P_ROYALTY"]:
        target_layer = "L2_RELATIVISTIC_VM"
    elif payload_type in ["AUXPOW_EPOCH", "HEADER_ATTESTATION", "MERKLE_ROOT"]:
        target_layer = "L1_AUXPOW_BITCOIN"
    else:
        target_layer = "L3_SAVEPOINT_SANDBOX"
        
    cur.execute("SELECT consensus_mechanism, execution_prong, dynamic_fee_rate, current_anchor FROM sos_sidechain_routes WHERE layer_id=?", (target_layer,))
    route = cur.fetchone()
    conn.close()
    
    fee_sats = int(size_bytes * (route[2] / 100.0)) if route else 0
    return {
        "payload_type": payload_type,
        "routed_layer": target_layer,
        "mechanism": route[0] if route else "UNKNOWN",
        "gate": route[1] if route else "PRONG_3_THEORETICAL",
        "dynamic_fee": fee_sats,
        "anchor": route[3] if route else "ISOLATED"
    }

if len(sys.argv) > 2 and sys.argv[1] == "--route":
    p_type = sys.argv[2]
    sz = int(sys.argv[3]) if len(sys.argv) > 3 else 32768
    decision = route_payload(p_type, sz)
    print("=== SOVEREIGN MULTI-LAYER ROUTING DECISION ===")
    print(f"[*] Payload Type  : {decision['payload_type']} ({sz} Bytes)")
    print(f"[*] Target Layer  : {decision['routed_layer']}")
    print(f"[*] Consensus Bus : {decision['mechanism']}")
    print(f"[*] Execution Gate: {decision['gate']}")
    print(f"[*] Calculated Fee: {decision['dynamic_fee']} sats")
    print(f"[*] Active Anchor : {decision['anchor']}")

else:
    print("=== SOVEREIGN STATE TRANSITION ROUTER ===")
    print("Usage:")
    print("  sos-router --route <type> [bytes]   Compute deterministic layer route & gas fee")
